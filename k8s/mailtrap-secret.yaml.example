# MODELO — copie para "mailtrap-secret.yaml" e preencha com suas credenciais SMTP.
# O arquivo real está no .gitignore e NÃO deve ir pro GitHub.
# Credenciais no painel do Mailtrap (Sandbox -> SMTP Settings).
#   kubectl create secret generic mailtrap-secret \
#     --from-literal=MAIL_HOST=... --from-literal=MAIL_USER=... --from-literal=MAIL_PASS=...
apiVersion: v1
kind: Secret
metadata:
  name: mailtrap-secret
type: Opaque
stringData:
  MAIL_HOST: sandbox.smtp.mailtrap.io
  MAIL_USER: SEU_USUARIO_MAILTRAP
  MAIL_PASS: SUA_SENHA_MAILTRAP
