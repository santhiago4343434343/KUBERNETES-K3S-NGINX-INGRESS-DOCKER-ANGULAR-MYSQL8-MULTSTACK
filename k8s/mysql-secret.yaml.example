# MODELO — copie para "mysql-secret.yaml" e preencha com suas senhas.
# O arquivo real (mysql-secret.yaml) está no .gitignore e NAO deve ir pro GitHub.
#
#   cp k8s/mysql-secret.yaml.example k8s/mysql-secret.yaml
#   (edite as senhas e rode: kubectl apply -f k8s/mysql-secret.yaml)
apiVersion: v1
kind: Secret
metadata:
  name: mysql-secret
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: COLOQUE_UMA_SENHA_ROOT
  MYSQL_DATABASE: catalogo
  MYSQL_USER: catalogo_user
  MYSQL_PASSWORD: COLOQUE_UMA_SENHA_APP
