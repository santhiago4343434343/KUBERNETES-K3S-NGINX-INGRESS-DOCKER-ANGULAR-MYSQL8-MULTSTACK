# MODELO — copie para "jwt-secret.yaml" e preencha com um segredo real.
# O arquivo real (jwt-secret.yaml) está no .gitignore e NÃO deve ir pro GitHub.
#
# Dica: gere um segredo forte com ->  openssl rand -hex 32
# Ou crie direto pela linha de comando (sem arquivo):
#   kubectl create secret generic jwt-secret --from-literal=JWT_SECRET=SEU_SEGREDO_AQUI
apiVersion: v1
kind: Secret
metadata:
  name: jwt-secret
type: Opaque
stringData:
  JWT_SECRET: COLOQUE_UM_SEGREDO_LONGO_E_ALEATORIO
