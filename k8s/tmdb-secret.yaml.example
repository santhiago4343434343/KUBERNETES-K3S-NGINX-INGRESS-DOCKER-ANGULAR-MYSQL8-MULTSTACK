# EXEMPLO — não contém a chave real.
# Crie o secret de verdade assim (a chave nunca entra no Git):
#   kubectl create secret generic tmdb-secret --from-literal=TMDB_API_KEY=SUA_CHAVE_AQUI
apiVersion: v1
kind: Secret
metadata:
  name: tmdb-secret
type: Opaque
stringData:
  TMDB_API_KEY: SUA_CHAVE_TMDB_AQUI
