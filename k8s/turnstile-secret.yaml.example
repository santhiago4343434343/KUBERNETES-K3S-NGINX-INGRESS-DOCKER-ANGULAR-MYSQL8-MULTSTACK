# EXEMPLO — não contém a chave real.
# Pegue a Secret Key no painel do Cloudflare Turnstile.
#   kubectl create secret generic turnstile-secret --from-literal=TURNSTILE_SECRET=SUA_CHAVE_AQUI
apiVersion: v1
kind: Secret
metadata:
  name: turnstile-secret
type: Opaque
stringData:
  TURNSTILE_SECRET: SUA_SECRET_KEY_TURNSTILE_AQUI
