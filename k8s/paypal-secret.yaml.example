# MODELO — copie para "paypal-secret.yaml" e preencha com as credenciais Sandbox.
# O arquivo real está no .gitignore e NÃO deve ir pro GitHub.
# Credenciais em developer.paypal.com -> Apps & Credentials -> Sandbox.
#   kubectl create secret generic paypal-secret \
#     --from-literal=PAYPAL_CLIENT_ID=... --from-literal=PAYPAL_SECRET=...
apiVersion: v1
kind: Secret
metadata:
  name: paypal-secret
type: Opaque
stringData:
  PAYPAL_CLIENT_ID: SEU_CLIENT_ID_SANDBOX
  PAYPAL_SECRET: SEU_SECRET_SANDBOX
